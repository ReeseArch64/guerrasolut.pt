---
/**
 * Conjunto de ícones do site. Um só ficheiro, uma só grelha (24×24) e um só
 * traço (1,75px, extremidades redondas) — a coerência é o ponto.
 *
 * Decorativos por defeito (`aria-hidden`). Passar `title` transforma o ícone
 * em imagem com nome acessível, para quando o controlo não tem texto.
 */
export type IconName =
  | 'pesquisa'
  | 'telefone'
  | 'seta-baixo'
  | 'seta-direita'
  | 'menu'
  | 'fechar'
  | 'visto'
  | 'relampago'
  | 'whatsapp'
  | 'email'
  | 'relogio'
  | 'local'
  | 'aviso';

interface Props {
  name: IconName;
  /** Lado do quadrado, em px. Múltiplos de 2 mantêm o traço nítido. */
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 20, title, class: className } = Astro.props;

const PATHS: Record<IconName, string[]> = {
  pesquisa: ['M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14Z', 'm16.2 16.2 4.3 4.3'],
  telefone: [
    'M6.4 3.5h3.1l1.6 4-2 1.4a12.3 12.3 0 0 0 6 6l1.4-2 4 1.6v3.1a2 2 0 0 1-2.2 2A17.6 17.6 0 0 1 4.4 5.7a2 2 0 0 1 2-2.2Z',
  ],
  'seta-baixo': ['m6 9.5 6 6 6-6'],
  'seta-direita': ['M4 12h15.5', 'm13.5 6 6 6-6 6'],
  menu: ['M3.5 7h17', 'M3.5 12h17', 'M3.5 17h17'],
  fechar: ['m6 6 12 12', 'm18 6-12 12'],
  visto: ['m4.5 12.5 5 5 10-11'],
  relampago: ['M13.5 3 5.5 13.5h5.2l-.7 7.5 8-10.5h-5.2z'],
  whatsapp: [
    'M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.2 20.8l4.5-1.2A8.8 8.8 0 1 0 12 3.2Z',
    'M9.3 8.5c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.5l.6 1.5c.1.2 0 .4-.1.6l-.5.5c-.2.2-.2.4 0 .6a6 6 0 0 0 2.4 2.2c.2.1.4.1.6-.1l.4-.5c.2-.2.4-.3.6-.2l1.5.7c.3.1.4.3.4.5 0 1.1-.9 1.9-1.9 1.9-3.2 0-6.2-3.2-6.2-6.2 0-.6.1-1.1.4-1.5Z',
  ],
  email: ['M3.5 6.2h17v11.6h-17z', 'm3.5 7.2 8.5 5.9 8.5-5.9'],
  relogio: ['M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16Z', 'M12 7.6V12l2.9 1.9'],
  local: [
    'M12 20.8s6.4-5.6 6.4-10.2a6.4 6.4 0 1 0-12.8 0c0 4.6 6.4 10.2 6.4 10.2Z',
    'M12 8.3a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6Z',
  ],
  aviso: ['M12 3.6 21.2 19.6H2.8Z', 'M12 9.6v4.2', 'M12 16.8h.01'],
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
