---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { CONTACT, SITE } from '../config/site';
import tecnico from '../assets/hero/tecnico-recorte.png';
import estaleiro from '../assets/hero/obra-estaleiro-detalhe.png';

const phoneLocal = CONTACT.phoneDisplay.replace(/^\+351\s*/, '');
const horario = `Seg–Dom · ${CONTACT.opens.slice(0, 2)}–${CONTACT.closes.slice(0, 2)} h`;

const PROVAS = [
  'Visita técnica gratuita',
  'Eletricistas certificados',
  'Garantia por escrito',
];
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="gs-shell hero__grid">
    <div class="hero__text">
      <p class="eyebrow">
        <span class="eyebrow__wire" aria-hidden="true"></span>
        Especialistas em instalações elétricas
      </p>

      <h1 class="hero__title" id="hero-titulo">
        A solução certa para a <span class="hero__title-accent">sua obra</span>
      </h1>

      <p class="hero__lead">
        A eletricidade é o nosso ramo de origem — e, a partir daí, construção
        civil, remodelação e todas as restantes especialidades na mesma equipa.
      </p>

      <p class="hero__resumo">
        Equipa própria e multidisciplinar, ao serviço de particulares, empresas
        e condomínios em todo o Portugal continental desde {SITE.foundingDate}.
        Do quadro elétrico ao acabamento final, com o valor fechado por escrito
        antes de a obra começar.
      </p>

      <ul class="provas">
        {
          PROVAS.map((prova) => (
            <li class="provas__item">
              <Icon name="visto" size={18} class="provas__icon" />
              {prova}
            </li>
          ))
        }
      </ul>

      <div class="hero__actions">
        <a class="gs-btn gs-btn--cheia" href="/contactos/">
          Descrever o meu projecto
        </a>
        <a class="gs-btn gs-btn--traco" href="/servicos/">
          Ver serviços
          <Icon name="seta-direita" size={18} />
        </a>
      </div>

      <p class="hero__telefone">
        Ou ligue já:{' '}
        <a href={`tel:${CONTACT.phone}`}>{phoneLocal}</a>
        <span class="hero__horario">{horario}</span>
      </p>
    </div>

    <div class="chapa">
      <span class="chapa__fio" aria-hidden="true"></span>
      <span class="chapa__grelha" aria-hidden="true"></span>

      <Picture
        class="chapa__figura"
        src={tecnico}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 520, 720, 960]}
        sizes="(min-width: 64rem) 38vw, min(24rem, 88vw)"
        alt="Ilustração de um técnico da Guerra Solut, de capacete branco e camisa branca, num estaleiro de obra."
        loading="eager"
        fetchpriority="high"
      />

      <p class="chapa__etiqueta">
        Equipa própria · desde {SITE.foundingDate}
      </p>

      <div class="chapa__detalhe">
        <Picture
          src={estaleiro}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[280, 420, 560]}
          sizes="(min-width: 64rem) 18vw, min(12rem, 44vw)"
          alt="Ilustração de um edifício em estrutura de betão, com uma grua amarela em obra."
          loading="eager"
        />
      </div>
    </div>
  </div>

  <div class="faixa">
    <div class="gs-shell faixa__shell">
      <p class="faixa__principal">
        <Icon name="relampago" size={19} class="faixa__icon" />
        Resposta a pedidos em menos de 2 horas
      </p>
      <p class="faixa__nota">
        Urgências atendidas 24 h por dia, 7 dias por semana.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--gs-section-y);
  }

  .hero__grid {
    display: grid;
    gap: var(--gs-space-10);
    padding-block-end: var(--gs-section-y);
  }

  .hero__grid > * {
    min-inline-size: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--gs-space-3);
    margin: 0 0 var(--gs-space-5);
    font-family: var(--gs-font-title);
    font-size: var(--gs-size-xs);
    font-weight: 700;
    letter-spacing: var(--gs-track-label);
    text-transform: uppercase;
    color: var(--gs-accent);
  }

  .eyebrow__wire {
    inline-size: 2rem;
    block-size: 2px;
    flex: none;
    background: var(--gs-brand);
    transform-origin: left center;
  }

  .hero__title {
    margin: 0;
    font-size: var(--gs-size-h1);
    line-height: var(--gs-leading-display);
    letter-spacing: var(--gs-track-display);
    max-inline-size: 16ch;
  }

  .hero__title-accent {
    color: var(--gs-accent);
  }

  .hero__lead {
    margin: var(--gs-space-5) 0 0;
    max-inline-size: 46ch;
    font-size: var(--gs-size-lead);
    line-height: var(--gs-leading-snug);
    color: var(--gs-text);
  }

  .hero__resumo {
    margin: var(--gs-space-4) 0 0;
    max-inline-size: 52ch;
    color: var(--gs-text-muted);
  }

  .provas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gs-space-2) var(--gs-space-5);
    margin: var(--gs-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .provas__item {
    display: flex;
    align-items: center;
    gap: var(--gs-space-2);
    font-size: var(--gs-size-base);
    font-weight: 500;
    color: var(--gs-text);
  }

  .provas :global(.provas__icon) {
    color: var(--gs-accent);
    flex: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gs-space-3);
    margin-block-start: var(--gs-space-8);
  }

  @media (max-width: 29.99rem) {
    .hero__actions {
      display: grid;
    }
  }

  .hero__telefone {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gs-space-2) var(--gs-space-3);
    margin: var(--gs-space-5) 0 0;
    font-size: var(--gs-size-base);
    color: var(--gs-text-muted);
  }

  .hero__telefone a {
    font-family: var(--gs-font-title);
    font-size: var(--gs-size-lg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--gs-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__telefone a:hover {
    color: var(--gs-accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .hero__horario {
    font-size: var(--gs-size-xs);
    color: var(--gs-text-subtle);
    white-space: nowrap;
  }

  .chapa {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    inline-size: 100%;
    max-inline-size: 24rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--gs-plate-edge);
    border-radius: var(--gs-radius-lg);
    background: var(--gs-plate);
  }

  .chapa__fio {
    position: absolute;
    z-index: 4;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 2px;
    background: var(--gs-brand);
    transform-origin: top center;
  }

  .chapa__grelha {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--gs-plate-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--gs-plate-line) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: radial-gradient(
      115% 85% at 70% 15%,
      rgb(0 0 0 / 1) 30%,
      rgb(0 0 0 / 0) 100%
    );
  }

  .chapa :global(.chapa__figura) {
    position: absolute;
    z-index: 2;
    inset: 3rem 0 0;
    inline-size: 100%;
    block-size: calc(100% - 3rem);
    object-fit: contain;
    object-position: right bottom;
  }

  .chapa__etiqueta {
    position: absolute;
    z-index: 3;
    inset-block-start: 0;
    inset-inline: 0;
    margin: 0;
    padding: var(--gs-space-4) var(--gs-space-5);
    border-block-end: 1px solid var(--gs-plate-edge);
    font-family: var(--gs-font-title);
    font-size: var(--gs-size-xs);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: var(--gs-track-label);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--gs-plate-text-muted);
  }

  .chapa__detalhe {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--gs-space-4);
    inset-inline-start: var(--gs-space-4);
    inline-size: 45%;
    overflow: hidden;
    border: 1px solid var(--gs-plate-edge);
    border-block-start: 2px solid var(--gs-brand);
    border-radius: var(--gs-radius-md);
    box-shadow: var(--gs-shadow-panel);
  }

  .chapa__detalhe :global(img) {
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .faixa {
    border-block: 1px solid var(--gs-wash-edge);
    background: var(--gs-wash);
  }

  .faixa__shell {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gs-space-1) var(--gs-space-4);
    padding-block: var(--gs-space-4);
  }

  .faixa__principal {
    display: flex;
    align-items: center;
    gap: var(--gs-space-2);
    margin: 0;
    font-family: var(--gs-font-title);
    font-size: var(--gs-size-md);
    font-weight: 700;
    letter-spacing: var(--gs-track-tight);
    color: var(--gs-wash-text);
  }

  .faixa :global(.faixa__icon) {
    flex: none;
  }

  .faixa__nota {
    margin: 0;
    font-size: var(--gs-size-base);
    color: var(--gs-text-muted);
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
      align-items: center;
      gap: var(--gs-space-12);
    }

    .chapa {
      inline-size: 100%;
      aspect-ratio: 5 / 6;
    }

    .chapa__etiqueta {
      inset-block-start: var(--gs-space-5);
      inset-inline-start: var(--gs-space-6);
    }

    .chapa__detalhe {
      inline-size: 42%;
      inset-block-end: var(--gs-space-5);
      inset-inline-start: var(--gs-space-5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyebrow__wire {
      animation: corrente-x 520ms var(--gs-ease) both;
    }

    .chapa__fio {
      animation: corrente-y 760ms var(--gs-ease) 120ms both;
    }
  }

  @keyframes corrente-x {
    from {
      scale: 0 1;
    }
  }

  @keyframes corrente-y {
    from {
      scale: 1 0;
    }
  }
</style>
