# Cabeçalhos servidos pela Cloudflare Pages.
# Sintaxe: https://developers.cloudflare.com/pages/configuration/headers/

# Os ficheiros de `_astro/` levam hash do conteúdo no nome: qualquer alteração
# muda o URL, por isso podem ser guardados para sempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Ícones e imagens de `public/` não levam hash — uma semana de cache com
# revalidação chega.
/icons/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000
